# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Environment mode: development, staging, production
# This affects CORS, logging, and security settings
# DEV: Allows localhost origins, verbose logging
# PROD: Strict CORS, production-ready security
ENVIRONMENT=development

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Firebase API keys and project configuration
# Get these from Firebase Console > Project Settings
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.web.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your_firebase_app_id

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================
# Google Cloud Project ID (must match Firebase project)
GOOGLE_CLOUD_PROJECT=your-project-id

# Cloud Run Base URL for callbacks (set to deployed URL in production)
# Local dev: http://127.0.0.1:8080
# Production: https://your-service-xyz.run.app
CLOUD_RUN_BASE_URL=http://127.0.0.1:8080

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS
# =============================================================================
# Enable debug login endpoint (NEVER enable in production!)
# Set to 1 for local development to bypass authentication
# Set to 0 in production for security
ENABLE_DEBUG_LOGIN=0

# Skip OIDC validation (for local testing only)
# Set to 1 for local development, 0 for production
DEV_SKIP_OIDC=0

# =============================================================================
# IFLOW CONFIGURATION
# =============================================================================
# iFlow automation system credentials
# These are optional - users can set their own credentials via the UI
# These serve as system-wide fallback values

# iFlow application URL
IFLOW_URL=https://app.hriflow.ro/#/dashboard

# iFlow login credentials
# SECURITY WARNING: In production, do NOT set these here
# Let users configure their own credentials via the settings UI
IFLOW_USERNAME=your-email@company.com
IFLOW_PASSWORD=your-password-here

# Playwright automation settings
# Run browser in headless mode (true for production, false for debugging)
IFLOW_HEADLESS=true

# Browser automation timeout in milliseconds (default: 30000 = 30 seconds)
IFLOW_TIMEOUT=30000

# =============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# =============================================================================
# Before deploying to production, ensure:
# 1. ENVIRONMENT=production
# 2. ENABLE_DEBUG_LOGIN=0
# 3. DEV_SKIP_OIDC=0
# 4. CLOUD_RUN_BASE_URL points to your production Cloud Run URL
# 5. Remove or leave empty IFLOW_USERNAME and IFLOW_PASSWORD
# 6. Update Firestore security rules (see firestore.rules comments)
# 7. Review CORS origins in app.py
