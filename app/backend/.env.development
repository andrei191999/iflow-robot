# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file is for LOCAL DEVELOPMENT and DEV deployment
# DO NOT use in production

# Environment mode
ENVIRONMENT=development

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
FIREBASE_API_KEY=AIzaSyBdXhCOMR0Yzyn6qtrCRzk_D12psPN7c44
FIREBASE_WEB_API_KEY=AIzaSyBdXhCOMR0Yzyn6qtrCRzk_D12psPN7c44
FIREBASE_AUTH_DOMAIN=iflow-robot.firebaseapp.com
FIREBASE_PROJECT_ID=iflow-robot
FIREBASE_APP_ID=1:416751442341:web:3c5ad9c7f654bee019704c

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================
GOOGLE_CLOUD_PROJECT=iflow-robot

# Cloud Run Base URL (for dev environment)
CLOUD_RUN_BASE_URL=http://127.0.0.1:8000

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS
# =============================================================================
# Enable debug features (NEVER enable in production!)
ENABLE_DEBUG_LOGIN=1
DEV_SKIP_OIDC=1

# =============================================================================
# IFLOW CONFIGURATION (Development)
# =============================================================================
# iFlow URL
IFLOW_URL=https://app.hriflow.ro/#/dashboard

# NOTE: For dev, test users will use pre-configured credentials
# Real users should set their own via the UI
IFLOW_USERNAME=
IFLOW_PASSWORD=

# Playwright settings for development
IFLOW_HEADLESS=false
IFLOW_TIMEOUT=30000

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Use local storage for screenshots in development
SCREENSHOT_STORAGE=local

# =============================================================================
# FEATURE FLAGS (Development)
# =============================================================================
# Enable test users
ENABLE_TEST_USERS=true

# Enable verbose logging
LOG_LEVEL=DEBUG
