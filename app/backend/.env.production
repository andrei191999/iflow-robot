# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# This file should be loaded in production Cloud Run deployment
# All sensitive values should come from environment variables or Secret Manager

# Environment mode
ENVIRONMENT=production

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
FIREBASE_API_KEY=AIzaSyBdXhCOMR0Yzyn6qtrCRzk_D12psPN7c44
FIREBASE_WEB_API_KEY=AIzaSyBdXhCOMR0Yzyn6qtrCRzk_D12psPN7c44
FIREBASE_AUTH_DOMAIN=iflow-robot.firebaseapp.com
FIREBASE_PROJECT_ID=iflow-robot
FIREBASE_APP_ID=1:416751442341:web:3c5ad9c7f654bee019704c

# =============================================================================
# GOOGLE CLOUD CONFIGURATION
# =============================================================================
GOOGLE_CLOUD_PROJECT=iflow-robot

# Cloud Run Base URL (production)
CLOUD_RUN_BASE_URL=https://iso-backend-416751442341.europe-west1.run.app

# =============================================================================
# SECURITY SETTINGS (Production)
# =============================================================================
# Disable all debug features in production
ENABLE_DEBUG_LOGIN=0
DEV_SKIP_OIDC=0

# =============================================================================
# IFLOW CONFIGURATION (Production)
# =============================================================================
# iFlow URL
IFLOW_URL=https://app.hriflow.ro/#/dashboard

# DO NOT set default credentials in production
# Users MUST configure their own via the UI and Secret Manager
IFLOW_USERNAME=
IFLOW_PASSWORD=

# Playwright settings for production
IFLOW_HEADLESS=true
IFLOW_TIMEOUT=30000

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Use Firebase Storage in production
SCREENSHOT_STORAGE=firebase

# =============================================================================
# FEATURE FLAGS (Production)
# =============================================================================
# Disable test users in production
ENABLE_TEST_USERS=false

# Production logging level
LOG_LEVEL=INFO
