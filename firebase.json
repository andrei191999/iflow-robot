{
    "hosting": {
        "public": "web/dist",
        "ignore": [
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "firestore": {
        "database": "(default)",
        "location": "eur3",
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    }
}